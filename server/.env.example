# Server Environment Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Database
# If left empty in development, an in-memory MongoDB instance will be automatically used.
MONGODB_URI=

# JWT Authentication
# Must be a secure random secret (min 32 characters in production)
JWT_SECRET=your_jwt_strong_secret_key_minimum_32_chars
JWT_EXPIRES_IN=7d

# LLM & AI Services (Required for Phase 3+)
GEMINI_API_KEY=
OPENROUTER_API_KEY=
